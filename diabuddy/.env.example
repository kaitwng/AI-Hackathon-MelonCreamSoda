# Set these as server-side Sites runtime secrets. Never put real values here.
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
# 64 hexadecimal characters (32 random bytes); rotation disconnects existing sessions.
DEXCOM_SESSION_KEY=

# Future family services; keep service-role and Stripe keys server-side only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_FAMILY_MONTHLY=
# Public HTTPS application origin, no path; required for safe billing redirects.
APP_ORIGIN=
# Exact trusted deployment origin. Omit to retain the original Site domain.
DEXCOM_APP_ORIGIN=https://diabuddy-arcade-review.delicatecurio4.chatgpt.site
